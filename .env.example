# Copier ce fichier en .env puis remplir les valeurs. Le fichier .env ne doit JAMAIS être envoyé sur GitHub.

# --- PostgreSQL : utilisé par docker compose (obligatoire : POSTGRES_PASSWORD) ---
POSTGRES_DB=recruitment_db
POSTGRES_USER=recruitment_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

# --- Ports exposés sur ta machine ---
API_PORT=8000
REDIS_PORT=6379

# --- Base de données (Abderrahmane) ---
# URL utilisée quand tu lances l'API, Alembic ou le seed HORS Docker (la base écoute sur localhost).
# Dans Docker, docker-compose.yml la remplace automatiquement (hôte `postgres`). Mêmes identifiants que ci-dessus.
# Évite les caractères spéciaux (@ : / # %) dans le mot de passe : ils casseraient cette URL.
DATABASE_URL=postgresql+psycopg://recruitment_user:change_this_password@localhost:5432/recruitment_db

# --- Comptes de développement créés par `python -m database.seed.seed` (données fictives) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword!
SEED_CANDIDATE_EMAIL=candidate@example.com
SEED_CANDIDATE_PASSWORD=ChangeThisCandidatePassword!

# --- Authentification (Fatima) ---
JWT_SECRET=

# --- Emails : Mailtrap en test (Amina) ---
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USER=
MAILTRAP_PASSWORD=
ADMIN_EMAIL=

# --- Dossier où sont stockés les documents déposés (hors Git) ---
UPLOAD_DIR=storage/uploads

# --- Modèles locaux Ollama ---
# OLLAMA_MODEL remplace le modèle de TOUS les agents (utile sur un portable : qwen3.5:2b)
OLLAMA_MODEL=
# Modèle d'un agent précis (prioritaire sur tout). Défauts : mistral:7b pour l'agent 3, qwen3.5:4b pour les autres
OLLAMA_MODEL_AGENT3=
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m

# --- OCR Tesseract (agent 3) ---
# Chemin de tesseract.exe si Tesseract n'est pas dans C:\Program Files\Tesseract-OCR
TESSERACT_CMD=
TESSERACT_LANG=fra
TESSERACT_PSM=6
