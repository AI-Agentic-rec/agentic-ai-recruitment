# PostgreSQL connection
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recruitment_db

# Development seed accounts — replace before running
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword!
SEED_CANDIDATE_EMAIL=candidate@example.com
SEED_CANDIDATE_PASSWORD=ChangeThisCandidatePassword!
