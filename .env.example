# Copier ce fichier en .env puis remplir les valeurs. Le fichier .env ne doit JAMAIS être envoyé sur GitHub.

# --- Base de données (Abdo) ---
DATABASE_URL=

# --- Authentification (Fatima) ---
JWT_SECRET=

# --- Emails : Mailtrap en test (Amina) ---
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USER=
MAILTRAP_PASSWORD=
ADMIN_EMAIL=

# --- Dossier où sont stockés les documents déposés (hors Git) ---
UPLOAD_DIR=storage/uploads

# --- Modèles locaux Ollama ---
# OLLAMA_MODEL remplace le modèle de TOUS les agents (utile sur un portable : qwen3.5:2b)
OLLAMA_MODEL=
# Modèle d'un agent précis (prioritaire sur tout). Défauts : mistral:7b pour l'agent 3, qwen3.5:4b pour les autres
OLLAMA_MODEL_AGENT3=
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m

# --- OCR Tesseract (agent 3) ---
# Chemin de tesseract.exe si Tesseract n'est pas dans C:\Program Files\Tesseract-OCR
TESSERACT_CMD=
TESSERACT_LANG=fra
TESSERACT_PSM=6
